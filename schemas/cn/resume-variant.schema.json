{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-pilot-cn.local/schemas/resume-variant.schema.json",
  "title": "ResumeVariant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "template", "source_profile_sha256", "source_photo_sha256", "fact_ids", "order", "rewrites", "sensitive_authorizations", "status", "diff"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "template": { "enum": ["soe-one-page", "tech-two-page", "application-detail"] },
    "source_profile_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_photo_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "order": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "proposed_statement", "accepted"],
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "proposed_statement": { "type": "string", "minLength": 1 },
          "accepted": { "type": "boolean" }
        }
      }
    },
    "sensitive_authorizations": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "photo": { "type": "boolean" },
        "political_status": { "type": "boolean" }
      }
    },
    "status": { "enum": ["draft", "ready", "exported"] },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "rewritten", "reordered"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "rewritten": { "type": "array", "items": { "type": "object" } },
        "reordered": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-pilot-cn.local/schemas/resume-artifact-manifest.schema.json",
  "title": "ResumeArtifactManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "variant_id", "template", "resume_style", "source_resume_style_sha256", "fact_ids", "output", "content_sha256", "generated_at", "campaign_id", "job_id", "target_job_title", "tailoring_preview_id", "baseline_variant_id", "changed_fact_ids", "change_ratio", "maximum_change_ratio", "source_campaign_sha256", "source_profile_sha256", "source_job_sha256", "source_baseline_sha256", "source_tailoring_sha256", "selection_confirmation_sha256", "variant_confirmation_sha256", "source_photo_sha256", "photo_included", "sensitive_authorizations", "format", "qa"],
  "properties": {
    "schema_version": { "const": 2 },
    "variant_id": { "type": "string" },
    "template": { "type": "string" },
    "resume_style": { "enum": ["compact-photo", "compact-no-photo", "technical-two-page"] },
    "source_resume_style_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "output": { "type": "string" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string" },
    "campaign_id": { "type": "string", "pattern": "^campaign\\.[a-f0-9]{24}$" },
    "job_id": { "type": "string", "pattern": "^job\\.[a-f0-9]{16,64}$" },
    "target_job_title": { "type": "string", "minLength": 1 },
    "tailoring_preview_id": { "type": "string" },
    "baseline_variant_id": { "type": "string" },
    "changed_fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "change_ratio": { "type": "number", "minimum": 0, "maximum": 0.3 },
    "maximum_change_ratio": { "const": 0.3 },
    "source_campaign_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_profile_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_job_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_baseline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_tailoring_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selection_confirmation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "variant_confirmation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_photo_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "photo_included": { "type": "boolean" },
    "sensitive_authorizations": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "format": { "enum": ["md", "html", "docx", "pdf"] },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_traceability", "semantic_match", "page_count", "page_budget", "text_layer", "render_status", "truncation", "overlap", "whitespace", "photo_presence", "photo_aspect_ratio", "photo_bounds"],
      "properties": {
        "fact_traceability": { "const": true },
        "semantic_match": { "const": true },
        "page_count": { "type": ["integer", "null"], "minimum": 1 },
        "page_budget": { "type": "integer", "minimum": 1 },
        "text_layer": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "render_status": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "truncation": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "overlap": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "whitespace": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "photo_presence": { "enum": ["verified", "not_applicable", "pending_docx_render"] },
        "photo_aspect_ratio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "photo_bounds": { "enum": ["verified", "not_applicable", "pending_docx_render"] }
      }
    }
  }
}

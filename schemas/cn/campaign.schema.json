{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-pilot-cn.local/schemas/campaign.schema.json",
  "title": "Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "employer", "recruitment_batch", "deadline", "constraints", "jobs", "ranking", "selection", "audit_events", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^campaign\\.[a-f0-9]{24}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "employer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "recruitment_batch": { "type": "string", "maxLength": 200 },
    "deadline": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value", "confirmation_status", "source_quote"],
        "properties": {
          "id": { "type": "string", "pattern": "^constraint\\.[a-z0-9._-]+$" },
          "kind": { "enum": ["max_applications", "mutually_exclusive"] },
          "value": {},
          "confirmation_status": { "enum": ["pending", "confirmed", "rejected"] },
          "source_quote": { "type": "string" }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "content_sha256", "source_ref", "status", "exclusion_reason", "added_at"],
        "properties": {
          "job_id": { "type": "string", "pattern": "^job\\.[a-f0-9]{16,64}$" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "match_report_id": { "type": ["string", "null"] },
          "match_report_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "source_ref": { "type": "string" },
          "status": { "enum": ["included", "excluded"] },
          "exclusion_reason": { "type": ["string", "null"] },
          "added_at": { "type": "string" }
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "generated_at", "source_sha256", "profile_sha256", "entries"],
      "properties": {
        "status": { "enum": ["pending", "ready"] },
        "generated_at": { "type": ["string", "null"] },
        "source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "profile_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "job_id", "title", "eligibility", "recommendation", "fit_score", "fact_coverage", "gap_count", "hard_rule_results", "evidence_fact_ids", "gaps", "unknowns"],
            "properties": {
              "rank": { "type": "integer", "minimum": 1 },
              "job_id": { "type": "string" },
              "title": { "type": "string" },
              "eligibility": { "enum": ["eligible", "unknown", "ineligible"] },
              "recommendation": { "enum": ["apply", "consider", "need_more_info", "do_not_apply"] },
              "fit_score": { "type": "number", "minimum": 0, "maximum": 5 },
              "fact_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "gap_count": { "type": "integer", "minimum": 0 },
              "hard_rule_results": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["rule_id", "result", "candidate_fact_ids", "reason", "source_quote"],
                  "properties": {
                    "rule_id": { "type": "string" },
                    "result": { "enum": ["satisfied", "failed", "unknown"] },
                    "candidate_fact_ids": { "type": "array", "items": { "type": "string" } },
                    "reason": { "type": "string" },
                    "source_quote": { "type": "string" }
                  }
                }
              },
              "evidence_fact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "gaps": { "type": "array", "items": { "type": "string" } },
              "unknowns": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "job_ids", "confirmed_at", "reason", "ranking_sha256"],
      "properties": {
        "status": { "enum": ["pending", "confirmed"] },
        "job_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "confirmed_at": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "ranking_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "audit_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "recorded_at", "details"],
        "properties": { "type": { "type": "string" }, "recorded_at": { "type": "string" }, "details": { "type": "object" } }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
